# Copie para .env (ou defina no serviço de hospedagem). NUNCA commite valores reais.
APP_ENV=development            # production exige ADMIN_PIN
ADMIN_PIN=                     # PIN do painel e das rotas de administração (em dev, se vazio, gera um aleatório e mostra no terminal)
DATABASE_URL=sqlite:///./data/cantina.db   # troque por postgresql+psycopg://usuario:senha@host/db (instale psycopg)
CORS_ORIGINS=                  # só se o front ficar em outro domínio; separe por vírgula
TRUST_PROXY=false              # true atrás de proxy/Render (usa o último valor de X-Forwarded-For nos limites)
REPORT_INTERVAL_SECONDS=120    # relatório agendado (n8n simulado)
RATE_LIMIT_PER_MIN=300
ORDER_RATE_PER_MIN=20
MAX_WS_CONNECTIONS=300

# Web Push (opcional): gere com `python -m app.push generate` (dentro de backend/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
PUSH_ON_PREPARO=false          # true também avisa "pagamento confirmado/em preparo"

# Agente com LLM real (DESLIGADO por padrão; as regras respondem sem LLM)
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=
