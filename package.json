{
  "name": "cantina-digital-faesa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cantina Digital FAESA: app do aluno + painel da cantina (React + Vite + Tailwind) com backend FastAPI (REST + WebSocket).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "preview": "node scripts/start.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint apps packages",
    "test": "npm run test:web && npm run test:backend",
    "e2e": "node scripts/e2e.mjs",
    "setup:backend": "node scripts/setup-backend.mjs",
    "test:web": "npm run test --workspaces --if-present",
    "test:backend": "node scripts/test-backend.mjs",
    "audit": "npm audit && node scripts/audit-backend.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "30.1.3",
    "oxlint": "1.95.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}